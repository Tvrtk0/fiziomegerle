---
// fiziomegerle.com/kontakt
import Site from '../layouts/Site.astro';

const EMAIL = 'patrikmegerlebj@gmail.com';
const WHATSAPP = '';   // broj u medunarodnom obliku bez + i razmaka, npr. '385911234567'; prazno = kartica se ne prikazuje
---
<Site
  title="Kontakt | Patrik Megerle, fizioterapeut"
  description="Javi se Patriku Megerleu: Instagram, e-mail ili upitnik za suradnju. Odgovaram osobno."
  path="/kontakt/"
  crumb="Kontakt"
  lead="Pitanje o programu, o svojim leđima ili suradnji? Javi se. Odgovaram osobno, obično unutar 24 sata radnim danom."
>
<style>
  .ways{display:grid;gap:20px;}
  @media (min-width:760px){ .ways{grid-template-columns:1fr 1fr;} .way.main{grid-column:1/-1;} }
  .way{
    display:flex;gap:20px;align-items:flex-start;
    border:1px solid var(--line);border-radius:18px;padding:30px 26px;background:#fff;
    text-decoration:none;transition:border-color .2s ease,transform .2s ease,box-shadow .2s ease;
  }
  a.way:hover{border-color:var(--green);transform:translateY(-3px);box-shadow:0 18px 40px -24px rgba(17,21,26,.35);}
  .way.main{background:var(--ink);color:#fff;border-color:var(--ink);}
  .ic{
    width:58px;height:58px;flex:none;border-radius:50%;display:grid;place-items:center;
    background:var(--paper-2);color:var(--green);
  }
  .way.main .ic{background:var(--green);color:#fff;}
  .way h2{margin:2px 0 6px;}
  .way p{margin:0;color:var(--text-soft);font-size:.96rem;}
  .way.main p{color:var(--on-dark-soft);}
  .way .go{display:inline-block;margin-top:12px;font-family:var(--head);font-size:1.25rem;letter-spacing:.1em;text-transform:uppercase;color:var(--green);}
  .way.main .go{color:var(--sage);}
  .go.mail{text-transform:none;letter-spacing:.02em;font-family:var(--body);font-size:1rem;font-weight:600;word-break:break-all;}

  .note{
    margin-top:54px;background:var(--alert-wash);border-left:4px solid var(--alert);
    border-radius:0 14px 14px 0;padding:22px 24px;max-width:760px;
  }
  .note h3{color:var(--alert);margin:0 0 8px;}
  .note ul{margin:0 0 8px;padding-left:20px;}
  .note p{margin:0;color:var(--text-soft);}
</style>

  <section class="sec sec--tint">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Tu sam</p>
        <h2 class="h-lg">Kako mi se možeš javiti</h2>
        <hr class="rule">
      </div>

      <div class="ways">
        <a class="way main" href="https://forms.gle/iSmNp9EWRQMeRYUa7">
          <span class="ic" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 26 26" fill="none"><rect x="5" y="3" width="16" height="20" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M9 9h8M9 13h8M9 17h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
          <span>
            <h2 class="h-sm">Želiš u program</h2>
            <p>Ispuni kratak upitnik o svojim leđima. Javim ti se osobno i kažem koji paket ima smisla, ili da ti ne treba nijedan.</p>
            <span class="go">Ispuni upitnik →</span>
          </span>
        </a>

        <a class="way" href="https://ig.me/m/patrik_megerle">
          <span class="ic" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none"><rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.7"/><circle cx="17.6" cy="6.4" r="1.2" fill="currentColor"/></svg></span>
          <span>
            <h2 class="h-sm">Instagram</h2>
            <p>Kratko pitanje? Pošalji DM na @patrik_megerle.</p>
            <span class="go">Pošalji poruku →</span>
          </span>
        </a>

        <a class="way" href={`mailto:${EMAIL}`}>
          <span class="ic" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 26 26" fill="none"><rect x="3" y="6" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M4 7l9 7 9-7" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span>
          <span>
            <h2 class="h-sm">E-mail</h2>
            <p>Za duža pitanja i suradnje.</p>
            <span class="go mail">{EMAIL}</span>
          </span>
        </a>

        {WHATSAPP && (
          <a class="way" href={`https://wa.me/${WHATSAPP}`}>
            <span class="ic" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 26 26" fill="none"><path d="M4 22l1.4-4.6A9 9 0 1 1 9 21z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span>
            <span>
              <h2 class="h-sm">WhatsApp</h2>
              <p>Poruka, ne poziv. Odgovaram radnim danom.</p>
              <span class="go">Otvori chat →</span>
            </span>
          </a>
        )}
      </div>

      <div class="note">
        <h3 class="h-sm">Hitno? Ne piši meni, javi se liječniku</h3>
        <ul>
          <li>gubitak kontrole mokraćnog mjehura ili crijeva</li>
          <li>progresivna slabost noge</li>
          <li>utrnulost u predjelu trtice</li>
        </ul>
        <p>To nije za poruku na Instagramu. Idi na hitnu ili svom liječniku.</p>
      </div>
    </div>
  </section>
</Site>
