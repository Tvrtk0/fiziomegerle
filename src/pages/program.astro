---
// fiziomegerle.com/program — Online programi
// Ponuda slozena po "$100M Offers" (Hormozi): san, vjerojatnost, vrijeme, trud,
// problemi -> rjesenja, paketi, garancija, ogranicenje mjesta. Sve potvrdio Patrik 28.09.2026.
import Site from '../layouts/Site.astro';
import Photo from '../components/Photo.astro';

const FORM = 'https://forms.gle/iSmNp9EWRQMeRYUa7';
const APP = '/img/sklek.jpg';   // screenshot Trainerize aplikacije ili ti dok izvodis vjezbu
const check = '<svg width="20" height="20" viewBox="0 0 22 22" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="10" stroke="currentColor" stroke-width="1.6"/><path d="M6.5 11.3l3 3 6-6.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<Site
  title="Online programi | 12-tjedni program za uredske radnike"
  description="Plan korak po korak za bol u leđima i herniju diska: od smirivanja boli do povratka punoj funkciji, za 12 tjedana, kod kuće. Standard 400 €, Premium 600 €."
  path="/program/"
  crumb="Online programi"
  lead="12-tjedni program za uredske radnike. Sjediš 8 sati, a leđa ti to naplaćuju? Ovo je plan korak po korak, od smirivanja boli do toga da opet sjediš, ustaješ i treniraš bez straha."
>
<style>
  .facts{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:10px;justify-content:center;}
  .facts li{
    font-family:var(--head);font-size:1.2rem;letter-spacing:.1em;text-transform:uppercase;
    border:1px solid var(--line);border-radius:999px;padding:9px 18px 6px;background:#fff;
  }

  /* prepoznaj se */
  .pains{display:grid;gap:14px;margin:0;padding:0;}
  @media (min-width:760px){ .pains{grid-template-columns:1fr 1fr;} }
  .pains li{
    list-style:none;background:#fff;border:1px solid var(--line);border-radius:14px;
    padding:18px 20px 18px 50px;position:relative;
  }
  .pains li::before{content:"";position:absolute;left:20px;top:29px;width:16px;height:2px;background:var(--alert);}

  /* problem -> rjesenje */
  .fix{display:grid;gap:18px;}
  @media (min-width:760px){ .fix{grid-template-columns:1fr 1fr;} }
  .fix-row{border:1px solid var(--line-dark);border-radius:16px;padding:24px 24px 22px;}
  .fix-row s{
    display:block;font-family:var(--head);font-size:1.3rem;letter-spacing:.05em;text-transform:uppercase;
    color:var(--on-dark-soft);text-decoration-color:var(--alert);text-decoration-thickness:2px;margin-bottom:10px;
  }
  .fix-row .h-sm{color:var(--sage);margin-bottom:6px;}
  .fix-row p{margin:0;color:#D8DDE0;}

  /* faze */
  .phases{display:grid;gap:18px;}
  @media (min-width:900px){ .phases{grid-template-columns:repeat(4,1fr);} }
  .phase{background:#fff;border:1px solid var(--line);border-radius:18px;padding:28px 22px 24px;display:flex;flex-direction:column;gap:10px;}
  .phase:last-child{background:var(--green);color:#fff;border-color:var(--green);}
  .ph-n{font-family:var(--head);font-size:3.4rem;font-weight:600;line-height:.8;color:var(--green);}
  .phase:last-child .ph-n{color:#fff;}
  .ph-when{font-family:var(--head);font-size:1.1rem;letter-spacing:.14em;text-transform:uppercase;color:var(--text-soft);}
  .phase:last-child .ph-when,.phase:last-child p{color:#E3ECE6;}
  .phase p{margin:0;font-size:.95rem;color:var(--text-soft);}
  .ph-win{margin-top:auto !important;padding-top:12px;border-top:1px solid var(--line);color:var(--text) !important;font-weight:600;font-size:.92rem !important;}
  .phase:last-child .ph-win{border-color:rgba(255,255,255,.25);color:#fff !important;}

  /* paketi */
  .tiers{display:grid;gap:24px;align-items:stretch;max-width:980px;margin:0 auto;}
  @media (min-width:820px){ .tiers{grid-template-columns:1fr 1fr;} }
  .tier{
    background:#fff;border:1px solid var(--line);border-radius:22px;
    padding:40px 32px 32px;display:flex;flex-direction:column;gap:18px;position:relative;
  }
  .tier--top{background:var(--ink);color:#fff;border-color:var(--ink);box-shadow:0 30px 60px -30px rgba(17,21,26,.6);}
  .tag{
    position:absolute;top:-15px;left:50%;transform:translateX(-50%);
    font-family:var(--head);font-size:1.1rem;letter-spacing:.14em;text-transform:uppercase;
    background:var(--sage);color:var(--ink);padding:7px 18px 4px;border-radius:999px;white-space:nowrap;
  }
  .tier .h-md{text-align:center;}
  .tier .for{margin:-6px 0 0;text-align:center;color:var(--text-soft);font-size:.95rem;}
  .tier--top .for{color:var(--on-dark-soft);}
  .price{text-align:center;padding:14px 0 18px;border-bottom:1px solid var(--line);}
  .tier--top .price{border-color:var(--line-dark);}
  .price b{display:block;font-family:var(--head);font-weight:600;font-size:4.6rem;line-height:.85;}
  .tier--top .price b{color:var(--sage);}
  .price span{font-size:.88rem;color:var(--text-soft);}
  .tier--top .price span{color:var(--on-dark-soft);}
  .inc{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;}
  .inc li{display:flex;gap:12px;align-items:flex-start;font-size:.97rem;line-height:1.45;}
  .inc li :global(svg){flex:none;margin-top:1px;color:var(--green);}
  .tier--top .inc li :global(svg){color:var(--sage);}
  .inc small{display:block;color:var(--text-soft);font-size:.85rem;}
  .tier--top .inc small{color:var(--on-dark-soft);}
  .inc .plus{font-family:var(--head);font-size:1.25rem;letter-spacing:.1em;text-transform:uppercase;color:var(--sage);}
  .tier .btn{margin-top:auto;width:100%;}
  .spots{margin:-4px 0 0;font-size:.84rem;color:var(--on-dark-soft);text-align:center;}
  .anchor{max-width:680px;margin:40px auto 0;text-align:center;color:var(--text-soft);}

  /* garancija */
  .guarantee{display:grid;gap:30px;align-items:center;}
  @media (min-width:820px){ .guarantee{grid-template-columns:auto 1fr;gap:56px;} }
  .seal{
    width:170px;height:170px;border-radius:50%;border:2px solid var(--sage);
    display:grid;place-items:center;text-align:center;margin:0 auto;
    box-shadow:0 0 0 10px var(--ink),0 0 0 11px var(--line-dark);
  }
  .seal b{font-family:var(--head);font-size:4rem;line-height:.8;color:var(--sage);display:block;}
  .seal span{font-family:var(--head);font-size:1.15rem;letter-spacing:.14em;text-transform:uppercase;}
  .guarantee p{margin:14px 0 0;color:var(--on-dark-soft);max-width:600px;}
  .guarantee p b{color:#fff;font-weight:600;}

  /* tko vodi */
  .split{display:grid;gap:40px;align-items:center;}
  @media (min-width:860px){ .split{grid-template-columns:1fr 1.1fr;gap:64px;} }
  .split .photo{border-radius:18px;overflow:hidden;}
  .split p{margin:0 0 14px;}

  /* nije za tebe */
  .notfor{background:var(--alert-wash);border-left:4px solid var(--alert);border-radius:0 16px 16px 0;padding:26px 26px 22px;max-width:820px;}
  .notfor h2{color:var(--alert);margin:0 0 12px;}
  .notfor ul{margin:0;padding-left:20px;}
  .notfor li{margin-bottom:8px;}

  /* pitanja */
  .faq{max-width:820px;margin:0 auto;border-top:1px solid var(--line);}
  .faq details{border-bottom:1px solid var(--line);}
  .faq summary{
    cursor:pointer;list-style:none;position:relative;padding:22px 44px 18px 0;
    font-family:var(--head);font-size:1.5rem;letter-spacing:.04em;text-transform:uppercase;line-height:1.05;
  }
  .faq summary::-webkit-details-marker{display:none;}
  .faq summary::after{
    content:"+";position:absolute;right:6px;top:16px;font-size:2rem;color:var(--green);
  }
  .faq details[open] summary::after{content:"–";}
  .faq summary:focus-visible{outline:2px solid var(--green);outline-offset:2px;}
  .faq p{margin:0 0 22px;color:var(--text-soft);}

  .final{background:var(--green);color:#fff;text-align:center;padding:84px 0;}
  .final p{max-width:560px;margin:16px auto 30px;color:#E3ECE6;}
  .final .btn{background:#fff;color:var(--green);border-color:#fff;}
  .final .btn:hover{background:var(--ink);color:#fff;border-color:var(--ink);}
</style>

  <!-- ukratko -->
  <section style="padding:34px 0;background:var(--paper-2);border-bottom:1px solid var(--line);">
    <div class="container">
      <ul class="facts" aria-label="Ukratko">
        <li>12 tjedana</li><li>4 faze</li><li>30–40 min po treningu</li><li>Kod kuće</li><li>Video za svaku vježbu</li>
      </ul>
    </div>
  </section>

  <!-- 1. prepoznaj se -->
  <section class="sec">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Za koga je</p>
        <h2 class="h-lg">Zvuči poznato?</h2>
        <hr class="rule">
      </div>
      <ul class="pains">
        <li>Ujutro si ukočen, a oko tri popodne počne probadati donji dio leđa.</li>
        <li>Iz auta ili sa stolice ustaješ „u dva dijela“.</li>
        <li>Imaš nalaz magnetne s hernijom i bojiš se svakog saginjanja.</li>
        <li>Probao si vježbe s YouTubea. Jedan dan bolje, drugi gore.</li>
        <li>Rekli su ti „odmaraj i pij tablete“. Odmaraš, piješ, a ništa se ne mijenja.</li>
      </ul>
    </div>
  </section>

  <!-- 2. zasto dosad nije islo -->
  <section class="sec dark">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Što je drukčije</p>
        <h2 class="h-lg">Nije problem u tebi. Nisi imao redoslijed.</h2>
        <hr class="rule">
      </div>
      <div class="fix">
        <div class="fix-row"><s>Nasumične vježbe s interneta</s><h3 class="h-sm">Četiri faze, strogo po redu</h3><p>Svaka vježba ima svoje mjesto i razlog zašto je baš tu.</p></div>
        <div class="fix-row"><s>Potpuni odmor ili guranje kroz bol</s><h3 class="h-sm">Jasna granica boli</h3><p>Znaš koliko smije boljeti i što napraviti kad zaboli više.</p></div>
        <div class="fix-row"><s>„Kad mogu dalje?“ Nitko ne zna</s><h3 class="h-sm">Kriteriji za prelazak</h3><p>U sljedeću fazu ideš kad ih ispuniš, ne kad ti se čini da je vrijeme.</p></div>
        <div class="fix-row"><s>Sam si i ne znaš radiš li dobro</s><h3 class="h-sm">Fizioterapeut s tobom</h3><p>Check-in na svakoj fazi, a u Premiumu svaki tjedan.</p></div>
      </div>
    </div>
  </section>

  <!-- 3. faze -->
  <section class="sec sec--tint" id="faze">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Kako izgleda 12 tjedana</p>
        <h2 class="h-lg">Jedna faza, jedan cilj</h2>
        <hr class="rule">
        <p class="soft">Tek kad ostvariš cilj faze, ideš dalje.</p>
      </div>
      <div class="phases">
        <div class="phase"><span class="ph-n">01</span><span class="ph-when">Tjedan 1–2</span><h3 class="h-sm">Smirivanje boli</h3><p>Hodanje, disanje i ekstenzija. Smirujemo iritaciju živca bez potpunog mirovanja.</p><p class="ph-win">Bol ti više ne diktira dan.</p></div>
        <div class="phase"><span class="ph-n">02</span><span class="ph-when">Tjedan 3–4</span><h3 class="h-sm">Vraćanje pokreta</h3><p>Kontrola trupa, gluteusi, mobilnost kukova. Strah od savijanja pada.</p><p class="ph-win">Sjediš i ustaješ bez razmišljanja o leđima.</p></div>
        <div class="phase"><span class="ph-n">03</span><span class="ph-when">Tjedan 5–9</span><h3 class="h-sm">Izgradnja snage</h3><p>Čučanj, pregib u kuku, snaga leđa i nogu. Opseg pokreta raste iz tjedna u tjedan.</p><p class="ph-win">Tijelo koje izdrži cijeli radni dan.</p></div>
        <div class="phase"><span class="ph-n">04</span><span class="ph-when">Tjedan 10–12</span><h3 class="h-sm">Povratak funkciji</h3><p>Bučice, iskoraci, mrtvo dizanje na jednoj nozi. Leđa pripremamo na stvarni život.</p><p class="ph-win">Treniraš i podižeš bez straha i znaš kako da se ne vrati.</p></div>
      </div>
    </div>
  </section>

  <!-- 4. paketi -->
  <section class="sec" id="paketi">
    <div class="container">
      <div class="sec-head center">
        <p class="kicker">Paketi</p>
        <h2 class="h-lg">Odaberi koliko me trebaš uz sebe</h2>
        <hr class="rule">
      </div>
      <div class="tiers">
        <article class="tier">
          <h3 class="h-md">Standard</h3>
          <p class="for">Za tebe koji si samostalan i trebaš jasan plan kojeg se držiš.</p>
          <div class="price"><b>400 €</b><span>jednokratno · ≈ 33 € tjedno</span></div>
          <ul class="inc">
            <li><Fragment set:html={check} /><span>Kompletan 12-tjedni plan u aplikaciji<small>sve 4 faze, trening po trening</small></span></li>
            <li><Fragment set:html={check} /><span>Video za svaku vježbu<small>vidiš točno kako se radi</small></span></li>
            <li><Fragment set:html={check} /><span>Kriteriji za prelazak u sljedeću fazu</span></li>
            <li><Fragment set:html={check} /><span>Pravila što raditi kad zaboli</span></li>
            <li><Fragment set:html={check} /><span>Check-in sa mnom na početku svake faze<small>4 check-ina: pregledam kako ide i prilagodim plan</small></span></li>
          </ul>
          <a class="btn" href={FORM}>Prijavi se</a>
        </article>

        <article class="tier tier--top">
          <span class="tag">Najbrži put</span>
          <h3 class="h-md">Premium</h3>
          <p class="for">Za tebe koji želiš da netko prati svaki tvoj tjedan i ne ostavi te da pogađaš.</p>
          <div class="price"><b>600 €</b><span>jednokratno · 50 € tjedno</span></div>
          <ul class="inc">
            <li class="plus">Sve iz Standarda, plus:</li>
            <li><Fragment set:html={check} /><span>Tjedni check-in sa mnom<small>12 check-ina, plan se prilagođava tebi svaki tjedan</small></span></li>
            <li><Fragment set:html={check} /><span>Video korekcija tehnike<small>snimiš vježbu, ja ti kažem što popraviti</small></span></li>
            <li><Fragment set:html={check} /><span>Direktna podrška na WhatsAppu<small>pitaš kad zapne, ne čekaš idući check-in</small></span></li>
            <li><Fragment set:html={check} /><span>Modul „Prehrana za oporavak“<small>kilaža, proteini i upala: što prehrana ima s tvojim leđima</small></span></li>
            <li><Fragment set:html={check} /><span>Pregled tvog dnevnika prehrane</span></li>
          </ul>
          <a class="btn" href={FORM}>Prijavi se za Premium</a>
          <p class="spots">Najviše 5 novih ljudi mjesečno, jer svakog pratim osobno.</p>
        </article>
      </div>
      <p class="anchor">
        Jedan termin kod privatnog fizioterapeuta košta 40–60 €. Za cijenu otprilike
        osam termina ovdje dobivaš cijelih 12 tjedana: plan, mene i redoslijed koji vodi do kraja.
      </p>
    </div>
  </section>

  <!-- 5. garancija -->
  <section class="sec dark">
    <div class="container guarantee">
      <div class="seal"><div><b>14</b><span>dana garancije</span></div></div>
      <div>
        <p class="kicker">Rizik je na meni</p>
        <h2 class="h-lg">Probaj 14 dana. Ako nije za tebe, vraćam novac.</h2>
        <p>
          Odradi prva dva tjedna po planu i zabilježi treninge u aplikaciji. Ako i
          dalje misliš da ovo nije za tebe, javi mi se i <b>vraćam ti cijeli iznos</b>.
          Bez objašnjavanja.
        </p>
      </div>
    </div>
  </section>

  <!-- 6. tko vodi -->
  <section class="sec">
    <div class="container split">
      <div class="photo"><Photo src={APP} alt="Patrik radi sklekove na vanjskom vježbalištu" label="screenshot aplikacije ili ti dok izvodiš vježbu" ratio="4/5" pos="center 45%" /></div>
      <div>
        <p class="kicker">Tko te vodi</p>
        <h2 class="h-lg">Plan, objašnjenje i ja kad zapne</h2>
        <hr class="rule">
        <p style="margin-top:24px;">
          Ja sam Patrik, prvostupnik fizioterapije. Na Instagramu svaki dan objašnjavam
          što se zapravo događa s tvojim leđima. Ovaj program je taj isti redoslijed,
          složen u 12 tjedana i spakiran tako da ga možeš raditi kod kuće.
        </p>
        <p class="soft">Ne obećavam čuda. Obećavam plan, objašnjenje za svaku vježbu i mene kad zapne.</p>
        <a class="btn btn--line" style="color:var(--green);margin-top:10px;" href="/o-meni/">Više o meni</a>
      </div>
    </div>
  </section>

  <!-- 7. nije za tebe -->
  <section class="sec" style="padding-top:0;">
    <div class="container">
      <div class="notfor">
        <h2 class="h-md">Ovaj program nije za tebe ako:</h2>
        <ul>
          <li>imaš gubitak kontrole mokraćnog mjehura ili crijeva, progresivnu slabost noge ili utrnulost oko trtice. Tada se odmah javi liječniku.</li>
          <li>tražiš masažu ili pasivnu terapiju. Ovdje ti radiš, a ja te vodim.</li>
          <li>ne možeš odvojiti 30–40 minuta za trening.</li>
          <li>si nedavno operiran ili imaš svježu ozljedu. Prvo razgovaraj sa svojim liječnikom.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 8. pitanja -->
  <section class="sec sec--tint">
    <div class="container">
      <div class="sec-head center">
        <p class="kicker">Pitanja</p>
        <h2 class="h-lg">Česta pitanja</h2>
        <hr class="rule">
      </div>
      <div class="faq">
        <details><summary>Ne radim u uredu. Je li ovo za mene?</summary><p>Da. Program je napravljen za bol u križima i herniju diska. Zove se „za uredske radnike“ jer je sjedenje najčešći razlog zbog kojeg mi se ljudi javljaju, ali radi i ako voziš, stojiš u smjeni ili fizički radiš.</p></details>
        <details><summary>Imam herniju na magnetnoj. Smijem li vježbati?</summary><p>U većini slučajeva ne samo da smiješ, nego trebaš. Hernija ne znači operaciju. Ako imaš neki od znakova iz crvenog okvira, prvo idi liječniku.</p></details>
        <details><summary>Trebam li teretanu ili opremu?</summary><p>Ne. Prve tri faze radiš s prostirkom kod kuće. Za zadnju fazu dobro dođe par bučica.</p></details>
        <details><summary>Što ako me tijekom programa zaboli?</summary><p>U programu imaš jasna pravila koliko smije boljeti i što napraviti kad zaboli više. U Premiumu mi se javiš na WhatsApp i riješimo to odmah.</p></details>
        <details><summary>Kako izgleda prijava i plaćanje?</summary><p>Ispuniš kratak upitnik. Javim ti se osobno, provjerimo je li program za tebe i koji paket ima smisla. Tek onda dobiješ podatke za uplatu i pristup aplikaciji.</p></details>
        <details><summary>Mogu li prvo probati nešto besplatno?</summary><p>Možeš. <a href="/#besplatno">„Prvih 14 dana“</a> je besplatna početna faza s testom. Ako ti pomogne, program je nastavak točno od te točke.</p></details>
      </div>
    </div>
  </section>

  <section class="final">
    <div class="container">
      <h2 class="h-lg">Prvi korak su dvije minute</h2>
      <p>Ispuni upitnik. Javljam ti se osobno i kažem koji paket ima smisla, ili ti iskreno kažem da ti ne treba nijedan.</p>
      <a class="btn" href={FORM}>Ispuni upitnik</a>
    </div>
  </section>
</Site>
