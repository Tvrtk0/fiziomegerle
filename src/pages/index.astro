---
// fiziomegerle.com — naslovnica
// Kviz je na /kviz (src/pages/kviz.astro)
---
<!doctype html>
<html lang="hr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Fizio Megerle</title>
  <meta name="description" content="Fizioterapeut za bol u ledima i vratu. Besplatna pocetna faza rehabilitacije i kviz o bolovima u ledima.">
  <meta name="theme-color" content="#141619">
  <link rel="canonical" href="https://fiziomegerle.com/">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Fizio Megerle">
  <meta property="og:description" content="Hernija ne znaci operaciju. Pocetna faza rehabilitacije, besplatno.">
  <meta property="og:url" content="https://fiziomegerle.com/">
  <meta property="og:locale" content="hr_HR">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;800&family=Newsreader:opsz,wght@6..72,300;6..72,400;6..72,500&display=swap">
<style is:global>
  :root{
    --ground:#141619;
    --panel:#1E222A;
    --panel-hi:#252A33;
    --line:#2E343E;
    --sage:#A7AF8A;
    --sage-deep:#7B8464;
    --sage-wash:#1C2119;
    --text:#EDEDE7;
    --muted:#949A9F;
    --alert:#D9765C;
    --alert-wash:#241A17;

    --display:"Archivo","Helvetica Neue",Arial,sans-serif;
    --body:"Newsreader",Georgia,"Times New Roman",serif;

    --measure:34rem;
  }

  *{box-sizing:border-box;}

  body{
    margin:0;
    background:var(--ground);
    color:var(--text);
    font-family:var(--body);
    font-size:17px;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }

  .wrap{
    max-width:var(--measure);
    margin:0 auto;
    padding:56px 22px 72px;
    display:flex;
    flex-direction:column;
    gap:52px;
  }

  /* ---------- eyebrow / labels ---------- */
  .eyebrow{
    font-family:var(--display);
    font-weight:600;
    font-size:.7rem;
    letter-spacing:.16em;
    text-transform:uppercase;
    color:var(--sage);
    margin:0;
  }

  /* ---------- hero ---------- */
  .hero{display:flex;flex-direction:column;gap:18px;}

  .hero h1{
    font-family:var(--display);
    font-weight:800;
    font-size:clamp(2.1rem,9vw,2.9rem);
    line-height:1.04;
    letter-spacing:-.022em;
    margin:0;
    text-wrap:balance;
  }
  .hero h1 em{font-style:normal;color:var(--sage);}

  .lede{margin:0;color:var(--muted);font-size:1.06rem;}

  .whois{
    display:flex;align-items:center;gap:12px;
    padding-top:6px;
  }
  .mark{
    width:64px;height:64px;flex:none;
    border-radius:50%;
    object-fit:cover;
    border:1px solid var(--sage-deep);
    display:block;
  }
  .whois span{font-size:.95rem;color:var(--muted);}
  .whois b{color:var(--text);font-weight:500;}

  /* ---------- routes ---------- */
  .routes{display:flex;flex-direction:column;gap:14px;}

  .route{
    display:block;
    text-decoration:none;
    color:inherit;
    background:var(--panel);
    border:1px solid var(--line);
    padding:22px 20px 20px;
    transition:background .18s ease, border-color .18s ease, transform .18s ease;
  }
  .route:hover,.route:focus-visible{
    background:var(--panel-hi);
    border-color:var(--sage-deep);
    transform:translateY(-2px);
  }
  .route:focus-visible{outline:2px solid var(--sage);outline-offset:3px;}

  .route--primary{
    background:var(--sage-wash);
    border-color:var(--sage-deep);
  }
  .route--primary:hover,.route--primary:focus-visible{background:#212819;}

  .route .q{
    font-family:var(--display);
    font-weight:600;
    font-size:.72rem;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--sage);
    display:block;
    margin-bottom:9px;
  }
  .route h2{
    font-family:var(--display);
    font-weight:800;
    font-size:1.42rem;
    letter-spacing:-.015em;
    margin:0 0 7px;
    line-height:1.15;
  }
  .route p{margin:0;color:var(--muted);font-size:.98rem;line-height:1.5;}

  .go{
    margin-top:15px;
    display:flex;align-items:center;gap:9px;
    font-family:var(--display);font-weight:600;
    font-size:.82rem;letter-spacing:.04em;
    color:var(--sage);
  }
  .go svg{transition:transform .18s ease;}
  .route:hover .go svg{transform:translateX(4px);}

  .free{
    display:inline-block;
    font-family:var(--display);font-weight:600;
    font-size:.64rem;letter-spacing:.13em;text-transform:uppercase;
    color:var(--ground);background:var(--sage);
    padding:3px 8px;margin-left:8px;vertical-align:2px;
  }

  /* ---------- section head ---------- */
  .sec{display:flex;flex-direction:column;gap:20px;}
  .sec > h3{
    font-family:var(--display);
    font-weight:800;
    font-size:1.28rem;
    letter-spacing:-.015em;
    margin:0;
  }
  .sec .note{margin:0;color:var(--muted);font-size:1rem;}

  /* ---------- spine / phases ---------- */
  .spine{
    list-style:none;margin:0;padding:0 0 0 30px;
    position:relative;
    display:flex;flex-direction:column;gap:22px;
  }
  .spine::before{
    content:"";position:absolute;left:6px;top:9px;bottom:9px;
    width:1px;background:var(--line);
  }
  .spine li{position:relative;}
  .spine li::before{
    content:"";position:absolute;left:-27px;top:7px;
    width:13px;height:13px;border-radius:3px;
    background:var(--ground);
    border:1.5px solid var(--sage-deep);
  }
  .spine li:first-child::before{background:var(--sage);border-color:var(--sage);}

  .ph-when{
    font-family:var(--display);font-weight:600;
    font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;
    color:var(--sage-deep);
    display:block;margin-bottom:3px;
  }
  .ph-name{
    font-family:var(--display);font-weight:600;
    font-size:1.02rem;color:var(--text);
    display:block;margin-bottom:2px;
  }
  .ph-goal{color:var(--muted);font-size:.95rem;line-height:1.5;}

  /* ---------- red flags ---------- */
  .flags{
    background:var(--alert-wash);
    border-left:3px solid var(--alert);
    padding:20px 20px 18px;
  }
  .flags h3{
    font-family:var(--display);font-weight:800;
    font-size:1.05rem;margin:0 0 10px;color:var(--alert);
    letter-spacing:-.01em;
  }
  .flags ul{margin:0 0 12px;padding-left:19px;color:var(--text);}
  .flags li{margin-bottom:4px;font-size:.98rem;}
  .flags p{margin:0;font-size:.98rem;color:var(--muted);}

  /* ---------- work with me ---------- */
  .work{
    border-top:1px solid var(--line);
    padding-top:34px;
    display:flex;flex-direction:column;gap:16px;
  }
  .work h3{
    font-family:var(--display);font-weight:800;
    font-size:1.28rem;margin:0;letter-spacing:-.015em;
  }
  .work p{margin:0;color:var(--muted);font-size:1rem;}

  .btn{
    align-self:flex-start;
    display:inline-flex;align-items:center;gap:9px;
    font-family:var(--display);font-weight:600;font-size:.9rem;
    letter-spacing:.02em;
    color:var(--ground);background:var(--sage);
    text-decoration:none;
    padding:12px 20px;
    transition:background .18s ease,transform .18s ease;
  }
  .btn:hover,.btn:focus-visible{background:#B9C09B;transform:translateY(-1px);}
  .btn:focus-visible{outline:2px solid var(--sage);outline-offset:3px;}

  /* ---------- footer ---------- */
  footer{
    border-top:1px solid var(--line);
    padding-top:26px;
    display:flex;flex-direction:column;gap:14px;
  }
  .social{
    display:inline-flex;align-items:center;gap:8px;
    font-family:var(--display);font-weight:600;font-size:.92rem;
    color:var(--sage);text-decoration:none;
    align-self:flex-start;
  }
  .social:hover,.social:focus-visible{color:#C2C9A6;}
  .social:focus-visible{outline:2px solid var(--sage);outline-offset:3px;}
  .fine{margin:0;font-size:.82rem;line-height:1.55;color:var(--muted);}

  @media (prefers-reduced-motion:reduce){
    *{transition:none !important;}
  }

  /* ---------- MailerLite obrazac, u nasem ruhu ---------- */
  .ml-form-embedContainer{margin-top:20px;}
  .ml-form-embedBody form{margin:0;}
  .ml-form-fieldRow{margin:0 0 11px;}
  .ml-field-group{display:flex;flex-direction:column;gap:5px;}
  .ml-field-group label{
    font-family:var(--display);font-weight:600;font-size:.68rem;
    letter-spacing:.13em;text-transform:uppercase;color:var(--sage);
  }
  .ml-form-embedBody input.form-control{
    width:100%;box-sizing:border-box;
    background:#171B22;color:var(--text);
    border:1px solid var(--line);border-radius:2px;
    font-family:var(--body);font-size:1rem;padding:11px 12px;
  }
  .ml-form-embedBody input.form-control:focus{
    outline:2px solid var(--sage);outline-offset:1px;border-color:var(--sage-deep);
  }
  .ml-form-embedPermissions{margin:15px 0 0;}
  .ml-form-embedPermissionsOptionsCheckbox label{
    display:flex;align-items:flex-start;gap:10px;cursor:pointer;
  }
  .ml-form-embedPermissionsOptionsCheckbox input[type=checkbox]{
    margin:3px 0 0;width:17px;height:17px;flex:none;accent-color:var(--sage);
  }
  .ml-form-embedPermissionsOptionsCheckbox .label-description{
    font-size:.85rem;line-height:1.45;color:var(--muted);
  }
  .ml-form-embedSubmit{margin-top:16px;}
  .ml-form-embedSubmit button.primary{
    width:100%;border:0;border-radius:2px;cursor:pointer;
    background:var(--sage);color:var(--ground);
    font-family:var(--display);font-weight:700;font-size:.95rem;
    letter-spacing:.02em;padding:13px;
    transition:background .18s ease;
  }
  .ml-form-embedSubmit button.primary:hover{background:#B9C09B;}
  .ml-form-embedSubmit button.loading{display:none;}
  .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);}
  .row-success h4{
    font-family:var(--display);font-weight:800;font-size:1.2rem;
    color:var(--sage);margin:0 0 8px;
  }
  .row-success p{margin:0;color:var(--text);font-size:.97rem;line-height:1.5;}
  .route--primary:hover{transform:none;background:var(--sage-wash);}
</style>
</head>
<body>
<div class="wrap">

  <header class="hero">
    <p class="eyebrow">Fizioterapeut &middot; online</p>
    <h1>Hernija ne znači <em>operaciju.</em></h1>
    <p class="lede">
      Pomažem ti da se riješiš boli u leđima i vratu — bez tableta
      i bez straha od pokreta.
    </p>
    <div class="whois">
      <img class="mark" src="data:image/jpeg;base64," alt="Patrik Megerle" width="64" height="64">
      <span><b>Patrik Megerle</b><br>Bol u leđima, vratu i držanje</span>
    </div>
  </header>

  <section class="routes" aria-label="Odaberi gdje si">

    <div class="route route--primary" id="preuzmi">
      <span class="q">Boli te sad?</span>
      <h2>Prvih 14 dana<span class="free">Besplatno</span></h2>
      <p>
        Početna faza rehabilitacije koju prolazim sa svojim klijentima
        u prva dva tjedna. Ako je upala izražena, ovdje se počinje.
      </p>

      <div id="mlb2-45806986" class="ml-form-embedContainer ml-subscribe-form ml-subscribe-form-45806986">
        <div class="ml-form-embedWrapper embedForm">
          <div class="ml-form-embedBody row-form">
            <form class="ml-block-form" action="https://assets.mailerlite.com/jsonp/2628629/forms/198263471418115576/subscribe" data-code="" method="post" target="_blank">
              <div class="ml-form-formContent">
                <div class="ml-form-fieldRow">
                  <div class="ml-field-group ml-field-name">
                    <label for="ml-ime">Ime</label>
                    <input id="ml-ime" aria-label="Ime" type="text" class="form-control" name="fields[name]" placeholder="" autocomplete="given-name">
                  </div>
                </div>
                <div class="ml-form-fieldRow ml-last-item">
                  <div class="ml-field-group ml-field-email ml-validate-email ml-validate-required">
                    <label for="ml-mail">E-mail</label>
                    <input id="ml-mail" aria-label="E-mail" aria-required="true" type="email" class="form-control" name="fields[email]" placeholder="" autocomplete="email">
                  </div>
                </div>
              </div>

              <div class="ml-form-embedPermissions">
                <div class="ml-form-embedPermissionsContent default">
                  <div class="ml-form-embedPermissionsOptions">
                    <div class="ml-form-embedPermissionsOptionsCheckbox">
                      <label>
                        <input type="checkbox" name="gdpr[]" value="Email">
                        <span class="label-description">Sla&#382;em se da mi Patrik Megerle po&#353;alje dokument na e-mail i povremeno korisne savjete o bolovima u le&#273;ima. Odjaviti se mogu bilo kad.</span>
                      </label>
                    </div>
                  </div>
                </div>
              </div>

              <input type="hidden" name="ml-submit" value="1">
              <div class="ml-form-embedSubmit">
                <button type="submit" class="primary">Pošalji mi dokument</button>
                <button disabled="disabled" style="display:none;" type="button" class="loading">
                  <div class="ml-form-embedSubmitLoad"></div><span class="sr-only">Šaljem…</span>
                </button>
              </div>
              <input type="hidden" name="anticsrf" value="true">
            </form>
          </div>

          <div class="ml-form-successBody row-success" style="display:none">
            <div class="ml-form-successContent">
              <h4>Provjeri sandučić</h4>
              <p>Dokument ti stiže za koju minutu. Ako ga nema, pogledaj i mapu Promocije.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <a class="route" href="https://fiziomegerle.com/">
      <span class="q">Ne znaš što ti je?</span>
      <h2>Kviz o bolovima u leđima</h2>
      <p>
        Nekoliko kratkih pitanja i saznaš radi li se vjerojatno
        o mišićnoj boli ili o problemu s diskom.
      </p>
      <span class="go">
        Započni kviz
        <svg width="15" height="11" viewBox="0 0 15 11" fill="none" aria-hidden="true">
          <path d="M1 5.5h12M9 1.5l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </a>

  </section>

  <section class="sec">
    <h3>Oporavak ide u fazama</h3>
    <p class="note">
      Najčešća greška je preskočiti korak. Ovo je redoslijed po kojem radim
      — dvanaest tjedana, četiri faze.
    </p>
    <ol class="spine">
      <li>
        <span class="ph-when">Tjedan 1–2</span>
        <span class="ph-name">Smanjenje upale</span>
        <span class="ph-goal">Smiriti iritaciju živca i zadržati minimalan pokret. Ovo dobivaš besplatno.</span>
      </li>
      <li>
        <span class="ph-when">Tjedan 3–4</span>
        <span class="ph-name">Rana subakutna faza</span>
        <span class="ph-goal">Postupno uvođenje pokreta i prve kontrole trupa. Strah od savijanja polako pada.</span>
      </li>
      <li>
        <span class="ph-when">Tjedan 5–9</span>
        <span class="ph-name">Izgradnja snage</span>
        <span class="ph-goal">Snaga trupa i nogu, širi opseg pokreta, priprema za normalne aktivnosti.</span>
      </li>
      <li>
        <span class="ph-when">Tjedan 10–12</span>
        <span class="ph-name">Povratak funkciji</span>
        <span class="ph-goal">Rad s opterećenjem i prevencija — da se isto ne ponovi za pola godine.</span>
      </li>
    </ol>
  </section>

  <section class="flags">
    <h3>Kad ti ne trebam ja, nego liječnik</h3>
    <ul>
      <li>Gubitak kontrole mokraćnog mjehura ili crijeva</li>
      <li>Progresivna slabost noge</li>
      <li>Utrnulost u predjelu trtice</li>
    </ul>
    <p>Ako imaš nešto od ovoga, ne kreći u vježbe — javi se liječniku.</p>
  </section>

  <section class="work">
    <h3>Želiš proći sve četiri faze?</h3>
    <p>
      Ispuni kratak upitnik da vidim gdje si. Javljam ti se osobno
      i kažem ti što ti je sljedeći korak — bez obveze.
    </p>
    <a class="btn" href="https://forms.gle/iSmNp9EWRQMeRYUa7">
      Ispuni upitnik
      <svg width="15" height="11" viewBox="0 0 15 11" fill="none" aria-hidden="true">
        <path d="M1 5.5h12M9 1.5l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </section>

  <footer>
    <a class="social" href="https://www.instagram.com/patrik_megerle/">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="currentColor" stroke-width="1.7"/>
        <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.7"/>
        <circle cx="17.6" cy="6.4" r="1.2" fill="currentColor"/>
      </svg>
      @patrik_megerle
    </a>
    <p class="fine">
      Sadržaj na ovoj stranici je opća edukacija, ne individualna terapija.
      Ako se simptomi pogoršavaju ili se pojave gore navedeni znakovi,
      javi se liječniku.
    </p>
  </footer>

<script>
  function ml_webform_success_45806986(){
    var $ = window.ml_jQuery || window.jQuery;
    $('.ml-subscribe-form-45806986 .row-success').show();
    $('.ml-subscribe-form-45806986 .row-form').hide();
  }
</script>
<script src="https://groot.mailerlite.com/js/w/webforms.min.js?v83147fa8ce2d95cb73ece7f28b469519" type="text/javascript"></script>
</div>
</body>
</html>
