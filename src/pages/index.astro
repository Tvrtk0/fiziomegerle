---
// fiziomegerle.com — Pocetna
import Site from '../layouts/Site.astro';
import Photo from '../components/Photo.astro';
import FreebieForm from '../components/FreebieForm.astro';

// Fotke su u public/img/. Prazno = iscrtkano mjesto.
const HERO = '/img/hero.jpg';     // velika fotka preko cijelog ekrana
const ABOUT = '/img/zgib.jpg';    // fotka za dio "Tko sam"
---
<Site
  title="Patrik Megerle | Fizioterapeut za bol u leđima i herniju diska"
  description="Fizioterapeut za bol u leđima, vratu i herniju diska. Online program od 12 tjedana, besplatna početna faza i kviz o bolovima u leđima."
  path="/"
>
<style>
  /* ---------- hero ---------- */
  .hero{
    position:relative;min-height:100vh;min-height:100svh;
    display:flex;align-items:flex-end;justify-content:center;
    color:#fff;text-align:center;overflow:hidden;
    background:var(--ink);
  }
  .hero-bg{position:absolute;inset:0;background-size:cover;background-position:53% 35%;}
  .hero-bg.ph{border:0;align-items:flex-start;justify-content:flex-end;padding:100px 24px;font-size:1.1rem;}
  .hero::after{
    content:"";position:absolute;inset:0;
    background:linear-gradient(180deg,rgba(17,21,26,.45) 0%,rgba(17,21,26,.05) 30%,rgba(17,21,26,.35) 55%,rgba(17,21,26,.92) 100%);
  }
  .hero-in{position:relative;z-index:1;padding:0 20px 13vh;max-width:820px;}
  .hero .kicker{color:var(--sage);font-size:1.3rem;}
  .hero p.sub{font-size:1.1rem;font-weight:400;line-height:1.6;margin:18px auto 0;max-width:520px;color:#E4E7E9;text-shadow:0 1px 12px rgba(0,0,0,.5);}
  .hero h1{text-shadow:0 2px 24px rgba(0,0,0,.35);}
  .hero .ctas{display:flex;flex-wrap:wrap;gap:14px;justify-content:center;margin-top:34px;}
  .scroll{position:absolute;left:50%;bottom:26px;z-index:1;transform:translateX(-50%);color:#fff;opacity:.6;}
  /* mobitel: fotka gore, tekst ispod, da naslov ne pada preko lica */
  @media (max-width:860px){
    .hero{display:block;min-height:0;}
    .hero::after{display:none;}
    .hero-bg{position:relative;inset:auto;height:62vh;height:62svh;min-height:380px;background-position:53% 38%;
      box-shadow:inset 0 130px 70px -60px rgba(17,21,26,.8),inset 0 -110px 70px -40px var(--ink);}
    .hero-in{margin:-44px auto 0;padding:0 20px 64px;}
    .scroll{display:none;}
  }
  /* siri ekran: tekst lijevo, fotka desno, da naslov ne pada preko lica */
  @media (min-width:861px){
    .hero{display:grid;grid-template-columns:minmax(380px,.85fr) 1.15fr;align-items:center;text-align:left;}
    .hero-bg{position:relative;inset:auto;grid-column:2;grid-row:1;align-self:stretch;min-height:100vh;background-position:55% 40%;box-shadow:inset 0 150px 90px -70px rgba(17,21,26,.85);}
    .scroll{display:none;}
    .hero::after{inset:0 auto 0 0;width:calc(42.5% + 140px);background:linear-gradient(90deg,var(--ink) calc(100% - 140px),rgba(17,21,26,0));}
    .hero-in{grid-column:1;grid-row:1;padding:110px 0 60px max(40px,calc((100vw - var(--max))/2 + 20px));max-width:none;}
    .hero h1{font-size:clamp(3.6rem,6.4vw,6rem);}
    .hero p.sub{margin-left:0;}
    .hero .ctas{justify-content:flex-start;}
  }

  /* ---------- tri ulaza ---------- */
  .cards{display:grid;gap:22px;}
  @media (min-width:860px){ .cards{grid-template-columns:repeat(3,1fr);} }
  .card{
    background:#fff;border:1px solid var(--line);border-radius:18px;
    padding:38px 30px 32px;text-align:center;
    display:flex;flex-direction:column;align-items:center;gap:14px;
    transition:transform .25s ease,box-shadow .25s ease;
  }
  .card:hover{transform:translateY(-4px);box-shadow:0 18px 40px -22px rgba(17,21,26,.35);}
  .icon{
    width:88px;height:88px;border-radius:50%;display:grid;place-items:center;
    background:var(--paper-2);color:var(--green);
    box-shadow:0 0 0 8px #fff,0 0 0 9px var(--line);margin-bottom:8px;
  }
  .card p{margin:0;color:var(--text-soft);font-size:.97rem;}
  .card .rule{margin:4px auto 2px;}
  .more{
    margin-top:auto;padding-top:6px;font-family:var(--head);font-size:1.2rem;letter-spacing:.1em;
    text-transform:uppercase;color:var(--green);text-decoration:none;
  }
  .more:hover{color:var(--green-hi);}

  /* ---------- brojke ---------- */
  .stats{display:grid;grid-template-columns:repeat(2,1fr);gap:34px 20px;text-align:center;}
  @media (min-width:860px){ .stats{grid-template-columns:repeat(4,1fr);} }
  .stat b{display:block;font-family:var(--head);font-weight:600;font-size:clamp(3rem,8vw,4.4rem);line-height:.9;color:#fff;}
  .stat span{font-family:var(--head);font-size:1.15rem;letter-spacing:.14em;text-transform:uppercase;color:var(--on-dark-soft);}

  /* ---------- tko sam ---------- */
  .split{display:grid;gap:44px;align-items:center;}
  @media (min-width:860px){ .split{grid-template-columns:1fr 1.1fr;gap:72px;} }
  .split .photo{border-radius:18px;overflow:hidden;}
  .split p{margin:0 0 16px;}
  .split .btn{margin-top:12px;}

  /* ---------- program ---------- */
  .gets{list-style:none;margin:0;padding:0;display:grid;gap:14px;}
  @media (min-width:700px){ .gets{grid-template-columns:1fr 1fr;gap:18px 40px;} }
  .gets li{display:flex;gap:14px;align-items:flex-start;}
  .gets li svg{flex:none;margin-top:5px;color:var(--green);}
  .gets b{display:block;font-family:var(--head);font-size:1.4rem;font-weight:500;letter-spacing:.04em;text-transform:uppercase;line-height:1.1;margin-bottom:2px;}
  .gets span{color:var(--text-soft);font-size:.95rem;}
  .mini{display:grid;gap:18px;margin-top:52px;}
  @media (min-width:700px){ .mini{grid-template-columns:1fr 1fr;} }
  .mini a{
    display:flex;justify-content:space-between;align-items:center;gap:16px;
    border:1px solid var(--line);border-radius:16px;padding:24px 26px;background:#fff;
    text-decoration:none;transition:border-color .2s ease,transform .2s ease;
  }
  .mini a:hover{border-color:var(--green);transform:translateY(-2px);}
  .mini a.top{background:var(--ink);color:#fff;border-color:var(--ink);}
  .mini .n{font-family:var(--head);font-size:1.9rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;line-height:1;}
  .mini .d{display:block;font-size:.88rem;color:var(--text-soft);margin-top:4px;}
  .mini a.top .d{color:var(--on-dark-soft);}
  .mini .p{font-family:var(--head);font-size:2.4rem;font-weight:600;line-height:1;white-space:nowrap;}
  .mini a.top .p{color:var(--sage);}

  /* ---------- besplatno ---------- */
  .free{display:grid;gap:44px;align-items:start;}
  @media (min-width:900px){ .free{grid-template-columns:1.1fr 1fr;gap:72px;} }
  .free ol{margin:22px 0 0;padding-left:20px;color:var(--on-dark-soft);}
  .free ol li{margin-bottom:6px;}
  .formbox{background:var(--ink-2);border:1px solid var(--line-dark);border-radius:18px;padding:30px 26px;}
  .formbox .h-sm{margin-bottom:18px;}
  .quiz{
    display:flex;gap:18px;align-items:center;justify-content:space-between;flex-wrap:wrap;
    margin-top:56px;padding-top:34px;border-top:1px solid var(--line-dark);
  }
  .quiz p{margin:4px 0 0;}

  /* ---------- zavrsni poziv ---------- */
  .final{background:var(--green);color:#fff;text-align:center;padding:84px 0;}
  .final p{max-width:560px;margin:16px auto 30px;color:#E3ECE6;}
  .final .btn{background:#fff;color:var(--green);border-color:#fff;}
  .final .btn:hover{background:var(--ink);color:#fff;border-color:var(--ink);}
</style>

  <!-- HERO -->
  <section class="hero">
    {HERO
      ? <div class="hero-bg" style={`background-image:url(${HERO})`} role="img" aria-label="Patrik Megerle u parku"></div>
      : <div class="hero-bg ph ph--dark">Foto: ti, velika vodoravna fotka<br>(preko cijelog ekrana)</div>}
    <div class="hero-in">
      <p class="kicker">Fizioterapeut · online</p>
      <h1 class="h-xl">Patrik Megerle</h1>
      <p class="sub">
        Pomažem ti da se riješiš boli u leđima i vratu, bez tableta
        i bez straha od pokreta. Hernija ne znači operaciju.
      </p>
      <div class="ctas">
        <a class="btn" href="/program/">Online programi</a>
        <a class="btn btn--line" href="#besplatno">Besplatno: prvih 14 dana</a>
      </div>
    </div>
    <svg class="scroll" width="22" height="34" viewBox="0 0 22 34" fill="none" aria-hidden="true"><rect x="1" y="1" width="20" height="32" rx="10" stroke="currentColor" stroke-width="1.6"/><path d="M11 8v7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  </section>

  <!-- S CIME POMAZEM -->
  <section class="sec sec--tint">
    <div class="container">
      <div class="sec-head center">
        <p class="kicker">S čime ti pomažem</p>
        <h2 class="h-lg">Gdje te boli?</h2>
        <hr class="rule">
      </div>
      <div class="cards">
        <article class="card">
          <span class="icon" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none"><rect x="14" y="4" width="12" height="7" rx="2" stroke="currentColor" stroke-width="2"/><rect x="14" y="16.5" width="12" height="7" rx="2" stroke="currentColor" stroke-width="2"/><rect x="14" y="29" width="12" height="7" rx="2" stroke="currentColor" stroke-width="2"/><path d="M26 20h6" stroke="#C8563B" stroke-width="2.4" stroke-linecap="round"/></svg>
          </span>
          <h3 class="h-sm">Hernija diska</h3>
          <hr class="rule">
          <p>Imaš nalaz s magnetne i bojiš se svakog saginjanja? Hernija u većini slučajeva ne znači operaciju. Znači plan.</p>
          <a class="more" href="/program/">Kako to rješavamo →</a>
        </article>
        <article class="card">
          <span class="icon" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none"><path d="M9 34V22h14l4 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M13 22V8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><rect x="24" y="12" width="12" height="8" rx="1.5" stroke="currentColor" stroke-width="2"/><path d="M30 20v4" stroke="currentColor" stroke-width="2"/></svg>
          </span>
          <h3 class="h-sm">Bol od sjedenja</h3>
          <hr class="rule">
          <p>Osam sati za stolom, ukočen ujutro, probada te popodne. Iz auta ustaješ „u dva dijela“. To se može promijeniti.</p>
          <a class="more" href="/program/">Pogledaj program →</a>
        </article>
        <article class="card">
          <span class="icon" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="10" r="6" stroke="currentColor" stroke-width="2"/><path d="M20 16v6M11 36c0-8 4-14 9-14s9 6 9 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M26 17l3-2" stroke="#C8563B" stroke-width="2.4" stroke-linecap="round"/></svg>
          </span>
          <h3 class="h-sm">Vrat i držanje</h3>
          <hr class="rule">
          <p>Laptop, mobitel, napeta ramena na kraju dana. Vrat nije „loš“, samo nije navikao na ovo što mu radiš.</p>
          <a class="more" href="/kviz/">Riješi kviz →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- BROJKE -->
  <section class="sec dark" style="padding:70px 0;">
    <div class="container stats">
      <div class="stat"><b>10+</b><span>godina u teretani</span></div>
      <div class="stat"><b>3.400+</b><span>ljudi me prati</span></div>
      <div class="stat"><b>12</b><span>tjedana programa</span></div>
      <div class="stat"><b>4</b><span>faze oporavka</span></div>
    </div>
  </section>

  <!-- TKO SAM -->
  <section class="sec">
    <div class="container split">
      <div class="photo">
        <Photo src={ABOUT} alt="Patrik radi zgibove na vanjskom vježbalištu" label="ti, portret ili na treningu" ratio="4/5" pos="center 40%" />
      </div>
      <div>
        <p class="kicker">Tko sam</p>
        <h2 class="h-lg">Fizioterapeut koji ti objasni, a ne samo pokaže</h2>
        <hr class="rule">
        <p style="margin-top:26px;">
          Ja sam Patrik, prvostupnik fizioterapije. Radio sam u Općoj bolnici
          Bjelovar i tamo vidio koliko ljudi ostane bez prave pomoći. Danas radim
          samostalno i bavim se leđima, vratom i hernijama diska.
        </p>
        <p class="soft">
          Ne obećavam čuda. Obećavam plan, objašnjenje za svaku vježbu i mene
          kad zapne.
        </p>
        <a class="btn" href="/o-meni/">Saznaj tko sam</a>
      </div>
    </div>
  </section>

  <!-- PROGRAM -->
  <section class="sec sec--tint">
    <div class="container">
      <div class="sec-head">
        <p class="kicker">Online program</p>
        <h2 class="h-lg">12 tjedana od boli do povratka punoj funkciji</h2>
        <hr class="rule">
      </div>
      <ul class="gets">
        <li><svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="10" stroke="currentColor" stroke-width="1.6"/><path d="M6.5 11.3l3 3 6-6.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><div><b>4 faze, strogo po redu</b><span>Od smirivanja boli do rada s opterećenjem.</span></div></li>
        <li><svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="10" stroke="currentColor" stroke-width="1.6"/><path d="M6.5 11.3l3 3 6-6.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><div><b>Video za svaku vježbu</b><span>U aplikaciji, trening po trening.</span></div></li>
        <li><svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="10" stroke="currentColor" stroke-width="1.6"/><path d="M6.5 11.3l3 3 6-6.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><div><b>Kriteriji za prelazak</b><span>Znaš točno kad smiješ ići dalje.</span></div></li>
        <li><svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="10" stroke="currentColor" stroke-width="1.6"/><path d="M6.5 11.3l3 3 6-6.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><div><b>Check-ini sa mnom</b><span>Na svakoj fazi ili svaki tjedan, ovisno o paketu.</span></div></li>
      </ul>
      <div class="mini">
        <a href="/program/#paketi">
          <span><span class="n">Standard</span><span class="d">Plan, videi, 4 check-ina</span></span>
          <span class="p">400 €</span>
        </a>
        <a class="top" href="/program/#paketi">
          <span><span class="n">Premium</span><span class="d">+ tjedni check-in, WhatsApp, prehrana</span></span>
          <span class="p">600 €</span>
        </a>
      </div>
      <p style="margin:34px 0 0;"><a class="btn" href="/program/">Pogledaj programe</a></p>
    </div>
  </section>

  <!-- BESPLATNO -->
  <section class="sec dark" id="besplatno">
    <div class="container">
      <div class="free">
        <div>
          <p class="kicker">Besplatno</p>
          <h2 class="h-lg">Prvih 14 dana</h2>
          <hr class="rule">
          <p class="soft" style="margin:24px 0 0;">
            Početna faza rehabilitacije koju prolazim sa svojim klijentima u prva
            dva tjedna. Ako te boli sad i upala je izražena, ovdje se počinje.
          </p>
          <ol>
            <li>Test koji ti pokaže smjer</li>
            <li>Pet vježbi s videom</li>
            <li>Što napraviti kad zaboli</li>
            <li>Dnevnik za 14 dana</li>
          </ol>
        </div>
        <div class="formbox">
          <p class="h-sm">Pošalji mi dokument</p>
          <FreebieForm />
        </div>
      </div>
      <div class="quiz">
        <div>
          <h3 class="h-md">Ne znaš što ti je?</h3>
          <p class="soft">Kratki kviz: je li vjerojatno mišićna bol ili problem s diskom.</p>
        </div>
        <a class="btn btn--line" href="/kviz/">Započni kviz</a>
      </div>
    </div>
  </section>

  <!-- ZAVRSNI POZIV -->
  <section class="final">
    <div class="container">
      <h2 class="h-lg">Spreman riješiti leđa?</h2>
      <p>Ispuni kratak upitnik. Javljam ti se osobno i kažem ti koji je tvoj sljedeći korak, bez obveze.</p>
      <a class="btn" href="https://forms.gle/iSmNp9EWRQMeRYUa7">Ispuni upitnik</a>
    </div>
  </section>
</Site>
